    "o": ["l", "o", "s", "t"],
    "d": ["g", "d", "D"],
    "w": ["w", "w", "W", "V"],
    "p": ["p", "p", "P"]
  },

  "sprites_note": "小圖：一個字元一個像素、'.' 透明。dx 是相對於物品中心的欄，top 是最上面那列離地幾格",
